# Lloyds Megathon X Problem Statement 2: Green Home Backend Environment
ENVIRONMENT=development
API_PORT=8000
API_HOST=0.0.0.0
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:5173
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Optional Supabase PostgreSQL configuration (Fallback fixtures used if unset)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Optional Gemini API (Deterministic template explanation fallback active when unset)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# UK DESNZ / DEFRA Official GHG Emissions Factors (kg CO2e per kWh)
ELECTRICITY_EMISSION_FACTOR_KG=0.20707
GAS_EMISSION_FACTOR_KG=0.18254
EMISSION_FACTORS_YEAR=2024
EMISSION_FACTORS_SOURCE=UK DESNZ / DEFRA Government GHG Conversion Factors 2024
